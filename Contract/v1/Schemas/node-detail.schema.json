{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrolabe.dev/schemas/v1/node-detail.schema.json",
  "title": "Astrolabe V1 Node Detail",
  "type": "object",
  "required": ["nodeID", "sections"],
  "properties": {
    "nodeID": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "attributes"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["identifier", "value"],
              "properties": {
                "identifier": { "type": "string", "minLength": 1 },
                "value": {
                  "type": "object",
                  "required": ["type", "value"],
                  "properties": {
                    "type": {
                      "enum": ["boolean", "integer", "decimal", "string", "stringList", "point", "size", "rect", "edgeInsets", "color", "constraints", "attributedTextRuns"]
                    },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
